erDiagram
    %% ===== Generalisation 1: PERSON => STUDENT | FACULTY (disjoint, total)
    PERSON ||--o| STUDENT : "is a"
    PERSON ||--o| FACULTY : "is a"
    PERSON ||--o| USER_ACCOUNT : "logs in as"

    %% ===== Generalisation 2: CLUB => TECHNICAL | CULTURAL | SPORTS (disjoint, partial)
    CLUB ||--o| TECHNICAL_CLUB : "is a"
    CLUB ||--o| CULTURAL_CLUB : "is a"
    CLUB ||--o| SPORTS_CLUB : "is a"

    %% ===== M:N relationships (bridge tables)
    STUDENT ||--o{ MEMBERSHIP : "joins"
    CLUB    ||--o{ MEMBERSHIP : "has"
    FACULTY ||--o{ CLUB_ADVISOR : "advises"
    CLUB    ||--o{ CLUB_ADVISOR : "guided by"
    STUDENT ||--o{ EVENT_REGISTRATION : "registers"
    EVENT   ||--o{ EVENT_REGISTRATION : "booked by"

    %% ===== 1:N relationships
    CLUB ||--o{ EVENT : "organises"
    CLUB ||--o{ CLUB_FUNDING : "receives"
    CLUB ||--o{ CLUB_ASSET : "owns"
    CLUB ||--o{ CLUB_DOCUMENT : "keeps"
    CLUB |o--o{ ANNOUNCEMENT : "posts (NULL = college-wide)"
    USER_ACCOUNT ||--o{ ANNOUNCEMENT : "authored by"

    PERSON {
        int person_id PK
        string name
        string email UK
        string phone
    }
    STUDENT {
        int student_id PK, FK "= person_id"
        string roll_no UK
        string branch "CHECK list"
        int year "CHECK 1-4"
    }
    FACULTY {
        int faculty_id PK, FK "= person_id"
        string department
        string designation "CHECK list"
    }
    USER_ACCOUNT {
        int user_id PK
        string username UK
        string password_hash
        string role "Admin | Student | Faculty"
        int person_id FK, UK "NULL for Admin"
        int is_active
        datetime created_at
    }
    CLUB {
        int club_id PK
        string name UK
        string category "discriminator"
        string tagline
        string description
        string room_no
        int founded_year
        string contact_email
        string status "Active | Inactive"
    }
    TECHNICAL_CLUB {
        int club_id PK, FK
        string github_url
        string tech_stack
    }
    CULTURAL_CLUB {
        int club_id PK, FK
        string art_form "CHECK list"
    }
    SPORTS_CLUB {
        int club_id PK, FK
        string sport
        string coach_name
    }
    CLUB_ADVISOR {
        int club_id PK, FK
        int faculty_id PK, FK
        date assigned_on
    }
    MEMBERSHIP {
        int student_id PK, FK
        int club_id PK, FK
        string role "President ... Member"
        date joined_at
    }
    EVENT {
        int event_id PK
        int club_id FK
        string title
        string event_type "CHECK list"
        string description
        datetime event_date
        date registration_deadline
        string venue
        int capacity "CHECK > 0"
        string status "Upcoming | Ongoing | Completed | Cancelled"
    }
    EVENT_REGISTRATION {
        int student_id PK, FK
        int event_id PK, FK
        datetime registered_at
    }
    CLUB_FUNDING {
        int funding_id PK
        int club_id FK
        string source_type "CHECK list"
        string sponsor_name
        real amount "CHECK > 0"
        date received_on
        string academic_year "YYYY-YY"
        string remarks
    }
    CLUB_ASSET {
        int asset_id PK
        int club_id FK
        string name
        string asset_type "CHECK list"
        int quantity "CHECK > 0"
        string condition "CHECK list"
        date acquired_on
        real cost
    }
    CLUB_DOCUMENT {
        int doc_id PK
        int club_id FK
        string title
        string doc_type "CHECK list"
        string url
        string visibility "Public | Members | Private"
        date uploaded_on
    }
    ANNOUNCEMENT {
        int announcement_id PK
        int club_id FK "NULL = college-wide"
        int posted_by FK
        string title
        string content
        string priority "Normal | Alert"
        int is_pinned
        datetime posted_at
        date expires_at
    }
